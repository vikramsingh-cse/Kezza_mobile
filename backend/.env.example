# Set APP_ENV=development only for a local developer machine.
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
PAYMENT_VERIFICATION_API_KEY=replace-with-a-separate-long-random-secret

# Use DATABASE_URL or all five DB_* values. Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kezza_db
DB_USER=kezza_user
DB_PASSWORD=replace-me
